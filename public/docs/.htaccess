# =========================================================
#  旧ドキュメント置き場 (hmk.delien.xyz/docs/)
#  docs.delien.xyz へ移管済みのため、配下はすべて転送する
# =========================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- hmk.delien.xyz/docs/... -> docs.delien.xyz/... ---
  RewriteCond %{HTTP_HOST} ^hmk\.delien\.xyz$ [NC]
  RewriteRule ^(.*)$ https://docs.delien.xyz/$1 [R=301,L,NE]

  # --- /foo/index.php -> /foo/ ---
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(?:php|html)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- /foo.php, /foo.html -> /foo（include/ は JS が直接読み込むため除外） ---
  RewriteCond %{REQUEST_URI} !/include/ [NC]
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.(?:php|html)[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # --- /foo -> /foo.php（内部処理） ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+)$ $1.php [L]
</IfModule>

DirectoryIndex index.php index.html
